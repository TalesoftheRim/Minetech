<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- MineTech Miner Armor-->

    <ThingDef ParentName="ArmorMachineableBase">
        <defName>MT_MinerArmor</defName>
        <label>Miner Armor</label>
        <description>A OSHA required armor, it protects only the required and is mostly for falling debris.</description>
        <techLevel>Industrial</techLevel>
        <recipeMaker>
            <researchPrerequisite>OrbitalTech</researchPrerequisite>
            <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
            <skillRequirements>
                <Crafting>7</Crafting>
            </skillRequirements>
        </recipeMaker>
        <graphicData>
            <texPath>Things/Apparel/Armor/MT_MinerArmor_icon</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>0.90</drawSize>
        </graphicData>
        <statBases>
            <WorkToMake>21000</WorkToMake>
            <MaxHitPoints>200</MaxHitPoints>
            <Mass>10</Mass>
            <Flammability>0.5</Flammability>
            <ArmorRating_Sharp>0.5</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.5</ArmorRating_Blunt>
            <ArmorRating_Heat>0.5</ArmorRating_Heat>
            <Insulation_Cold>70</Insulation_Cold>
            <Insulation_Heat>10</Insulation_Heat>
            <EquipDelay>4</EquipDelay>
        </statBases>
        <equippedStatOffsets>
            <MoveSpeed>-0.30</MoveSpeed>
            <AimingDelayFactor>-0.15</AimingDelayFactor>
            <VacuumResistance>0.32</VacuumResistance>
        </equippedStatOffsets>
        <thingCategories>
            <li>ApparelArmor</li>
        </thingCategories>
        <costList>
            <Steel>80</Steel>
			<Plasteel>20</Plasteel>
        </costList>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Neck</li>
                <li>Shoulders</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Apparel/Armor/MT_MinerArmor</wornGraphicPath>
            <layers>
                <li>Middle</li>
            </layers>
            <tags>
                <li>MT_Apparel_Miner</li>
            </tags>
            <defaultOutfitTags>
                <li>Worker</li>
                <li>Soldier</li>
            </defaultOutfitTags>
        </apparel>
        <tradeTags>
            <li>Clothing</li>
            <li>Armor</li>
        </tradeTags>
    </ThingDef>

